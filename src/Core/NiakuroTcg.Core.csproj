<Project Sdk="Microsoft.NET.Sdk">
  <!-- このファイルについて: ルールエンジン本体のプロジェクト設定。
       Unity 互換のため netstandard2.1 / C# 9 に揃えてある。
       Unity で使うときは、このフォルダ配下の .cs ファイルを Assets/Scripts/Core にコピーすればよい。 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>NiakuroTcg.Core</AssemblyName>
    <RootNamespace>Niakuro.Tcg.Core</RootNamespace>
  </PropertyGroup>
</Project>
